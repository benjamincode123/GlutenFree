{
  "expo": {
    "name": "AltUten",
    "slug": "altuten",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "altuten",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.altuten.app",
      "buildNumber": "7",
      "deploymentTarget": "16.4",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "AltUten uses the camera to scan grocery barcodes and photograph products for review.",
        "NSPhotoLibraryUsageDescription": "AltUten lets you attach a product photo when reporting a barcode.",
        "NSLocationWhenInUseUsageDescription": "AltUten uses your location to search the product catalog for your country first.",
        "CFBundleDisplayName": "AltUten",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.altuten.app",
      "versionCode": 7,
      "softwareKeyboardLayoutMode": "pan",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "AltUten uses the camera to scan grocery barcodes and photograph products for review."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AltUten lets you attach a product photo when reporting a barcode.",
          "cameraPermission": "AltUten uses the camera to photograph products for barcode reports."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AltUten uses your location to search the product catalog for your country first."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "defaultChannel": "alerts"
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
